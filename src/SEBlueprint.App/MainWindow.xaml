<Window x:Class="SEBlueprint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SEBlueprint.App.Controls"
        Title="SE Blueprint Inspector"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1380" Height="880" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource Bg0}">
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Border}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <c:Slant Fill="#0E2430" Stroke="{StaticResource BorderHi}" Offset="14" Height="40">
                        <StackPanel Orientation="Horizontal" Margin="4,0,8,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/app-icon.png" Width="26" Height="26" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SE BLUEPRINT" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" FontSize="15" LineHeight="15" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock Text="INSPECTOR" FontFamily="{StaticResource HeaderFont}" FontSize="11.5" Foreground="{StaticResource Accent}" />
                            </StackPanel>
                        </StackPanel>
                    </c:Slant>

                    <StackPanel Orientation="Horizontal" Margin="26,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="TabBlueprints" Style="{StaticResource TerminalTab}" Tag="&#xE8F1;" Content="BLUEPRINTS" GroupName="Tabs" Checked="OnTab" />
                        <RadioButton x:Name="TabProfiles" Style="{StaticResource TerminalTab}" Tag="&#xE9D2;" Content="LIMIT PROFILES" GroupName="Tabs" Checked="OnTab" />
                        <RadioButton x:Name="TabSettings" Style="{StaticResource TerminalTab}" Tag="&#xE713;" Content="SETTINGS" GroupName="Tabs" Checked="OnTab" />
                        <RadioButton x:Name="TabAbout" Style="{StaticResource TerminalTab}" Tag="&#xE946;" Content="INFO" GroupName="Tabs" Checked="OnTab" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="{StaticResource Bg1}">
                <Rectangle Fill="{StaticResource BlueprintGrid}" Opacity="0.6" />
                <Frame x:Name="PageHost" NavigationUIVisibility="Hidden" Focusable="False" />

                <c:SeFrame VerticalAlignment="Bottom" Margin="24,0,24,16" Fill="#F2341414" Stroke="{StaticResource Red}" Padding="14,10"
                           Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Dismiss" Click="OnDismissError" Padding="10,3" />
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{StaticResource Red}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </c:SeFrame>
            </Grid>

            <Grid Grid.Row="2" Background="{StaticResource Bg0}">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource Border}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <c:SegmentBar Width="110" Height="6" Segments="16" Value="{Binding ProgressRatio, Mode=OneWay}" Fill="{StaticResource Accent}" Margin="0,0,10,0"
                                  Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="PROFILE" FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ActiveProfile.Name}" FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="  ·  " Style="{StaticResource Dim}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Dim}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
