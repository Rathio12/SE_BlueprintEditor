<Page x:Class="SEBlueprint.App.Pages.BlueprintsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:SEBlueprint.App.Controls"
      xmlns:v="clr-namespace:SEBlueprint.App.Views"
      Title="Blueprints"
      Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}" FontSize="14">
    <Grid Margin="16,14,16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="340" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <c:SeFrame Style="{StaticResource Frame}" Brackets="{StaticResource Accent}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="14,14,14,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="OnRescan" Padding="10,4" ToolTip="Scan again for new or changed blueprints">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13" />
                        </Button>
                        <TextBlock Text="BLUEPRINTS" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,2,0,0" />
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <TextBox x:Name="Search" Tag="Search…" Padding="30,6,8,6" TextChanged="OnFilterChanged" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="10,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="GameFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="All games" />
                            <ComboBoxItem Content="SE1" />
                            <ComboBoxItem Content="SE2" />
                        </ComboBox>
                        <ComboBox x:Name="SourceFilter" Grid.Column="1" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="All sources" />
                            <ComboBoxItem Content="Local" />
                            <ComboBoxItem Content="Cloud" />
                            <ComboBoxItem Content="Workshop" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <ComboBox x:Name="SortBox" Grid.Column="2" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="OnSortChanged">
                            <ComboBoxItem Content="Newest first" />
                            <ComboBoxItem Content="Name" />
                            <ComboBoxItem Content="Most PCU" />
                            <ComboBoxItem Content="Most blocks" />
                            <ComboBoxItem Content="Most guns" />
                            <ComboBoxItem Content="Status" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <ListBox x:Name="List" Grid.Row="1" ItemContainerStyle="{StaticResource BlueprintItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                         SelectionChanged="OnSelected">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open folder" Click="OnOpenFolder" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="62">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <Border Grid.Column="1" Width="46" Height="46" Margin="10,0" Background="#0A1A22" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Path Data="{StaticResource Icon.Cargo}" Style="{StaticResource PathIcon}" Stroke="#2E5A6E" Width="20" Height="20" />
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Game, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                        <Run Text="·" Foreground="{StaticResource TextFaint}" />
                                        <Run Text="{Binding Source, Mode=OneWay}" Foreground="{StaticResource TextDim}" />
                                        <Run Text="{Binding ModdedTag, Mode=OneWay}" Foreground="{StaticResource Orange}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="10,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Pcu, Converter={StaticResource Unit}}" FontFamily="{StaticResource HeaderFont}" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource HeaderFont}" FontSize="11.5" HorizontalAlignment="Right"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Rows.Count, Converter={StaticResource Hidden}}">
                    <TextBlock Text="NO BLUEPRINTS FOUND" FontFamily="{StaticResource HeaderFont}" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="Add a folder in Settings." Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </c:SeFrame>

        <GridSplitter Grid.Column="1" Width="10" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

        <v:BlueprintDetail x:Name="Detail" Grid.Column="2" />
    </Grid>
</Page>
