<Page x:Class="SEBlueprint.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:SEBlueprint.App.Controls"
      Title="Settings"
      Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28" MaxWidth="1150" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <c:SeFrame x:Name="NotFoundBar" Style="{StaticResource Frame}" Margin="0,14,0,0" Stroke="{StaticResource Orange}" Padding="14,10">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{StaticResource Orange}" Margin="0,0,12,0" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Space Engineers not found." FontWeight="SemiBold" />
                        <Run Text="Set the game folder (the one containing Content) below." Foreground="{StaticResource TextDim}" />
                    </TextBlock>
                </DockPanel>
            </c:SeFrame>

            <TextBlock Text="Folders" Style="{StaticResource SectionTitle}" />
            <c:SeFrame Style="{StaticResource FrameAccent}">
                <StackPanel x:Name="PathsPanel">
                    <TextBlock Text="Detected from Steam. Override only if detection is wrong." Style="{StaticResource Dim}" Margin="0,0,0,8" />
                </StackPanel>
            </c:SeFrame>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Click="OnAddFolder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Add blueprint folder" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Click="OnRebuild" ToolTip="Re-read the game and all mods. Use after game or mod updates.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Rebuild game data" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="Feedback &amp; support" Style="{StaticResource SectionTitle}" />
            <c:SeFrame Style="{StaticResource Frame}" Brackets="{StaticResource Accent}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="REPORT A BUG" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Orange}" />
                        <TextBlock Text="Wrong numbers, a crash or a mod that isn't recognised? Open an issue and attach log.txt." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Button HorizontalAlignment="Left" Click="OnReportBug">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEBE8;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Orange}" Margin="0,0,8,0" />
                                <TextBlock Text="Report a bug" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="SUPPORT THIS APP" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="A star on GitHub helps other engineers find the tool. It's free and takes two seconds." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Button HorizontalAlignment="Left" Click="OnStar" Style="{StaticResource AccentButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="13" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="Star on GitHub" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="UPDATES" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Green}" />
                        <TextBlock Text="The app never updates itself. New versions and changelogs are on the releases page." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Button HorizontalAlignment="Left" Click="OnReleases">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Green}" Margin="0,0,8,0" />
                                <TextBlock Text="Releases" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </c:SeFrame>

        </StackPanel>
    </ScrollViewer>
</Page>
