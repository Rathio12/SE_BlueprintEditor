<UserControl x:Class="SEBlueprint.App.Views.BlueprintDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SEBlueprint.App.Controls"
             Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}" FontSize="14">
    <UserControl.Resources>
        <DataTemplate x:Key="CostRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" Background="#0A1A22" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" Margin="1" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding AmountText}" VerticalAlignment="Center" FontFamily="{StaticResource HeaderFont}"
                           FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Readout">
            <c:SeFrame Style="{StaticResource Frame}" Brackets="{Binding Brush}" Margin="0,0,10,0" Padding="16,12,16,14">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeaderFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource HeaderFont}" FontSize="30" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding LimitText}" FontFamily="{StaticResource HeaderFont}" FontSize="15" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,5" />
                    </StackPanel>
                    <c:SegmentBar Height="7" Segments="18" Value="{Binding Ratio}" Fill="{Binding Brush}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </c:SeFrame>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSelection, Converter={StaticResource Hidden}}">
            <Path Data="{StaticResource Icon.Cargo}" Style="{StaticResource PathIcon}" Width="44" Height="44" HorizontalAlignment="Center" />
            <TextBlock Text="SELECT A BLUEPRINT" FontFamily="{StaticResource HeaderFont}" FontSize="18" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
            <StackPanel Margin="0,0,8,16">

                <c:SeFrame Fill="#0A1A22" Stroke="{StaticResource BorderHi}" Chamfer="18" Padding="0" Height="196" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" HorizontalAlignment="Right" Opacity="0.85" Margin="1" />
                        <Rectangle Margin="1">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F00A1A22" Offset="0" />
                                    <GradientStop Color="#E00A1A22" Offset="0.45" />
                                    <GradientStop Color="#300A1A22" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Fill="{StaticResource BlueprintGrid}" Opacity="0.35" Margin="1" />

                        <DockPanel Margin="26,22,22,20">
                            <StackPanel DockPanel.Dock="Right" Width="250" VerticalAlignment="Top">
                                <TextBlock Text="LIMIT PROFILE" FontFamily="{StaticResource HeaderFont}" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,0,0,5" />
                                <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="OnProfileChanged" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <c:Slant Fill="{StaticResource AccentDim}" Offset="8" Height="22">
                                        <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" FontSize="12" Margin="6,0"
                                                   Foreground="White" VerticalAlignment="Center" />
                                    </c:Slant>
                                    <c:Slant Fill="#0A1A22" Stroke="{Binding OverallBrush}" Offset="8" Height="22" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding OverallText}" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" FontSize="12" Margin="6,0"
                                                   Foreground="{Binding OverallBrush}" VerticalAlignment="Center" />
                                    </c:Slant>
                                </StackPanel>
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeaderFont}" FontSize="34" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextDim}" FontSize="13.5" />
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding Error, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </c:SeFrame>

                <c:SeFrame Style="{StaticResource Frame}" Margin="0,10,0,0" Stroke="{StaticResource Accent}" Padding="14,10"
                           Visibility="{Binding IsPartial, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,12,0" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                   Text="SE2 blueprint: blocks and PCU are read from the blueprint info. Cost, weapons and cargo need the grid file, which uses an undocumented binary format." />
                    </DockPanel>
                </c:SeFrame>

                <ItemsControl Margin="0,12,-10,0" ItemsSource="{Binding Primary}" ItemTemplate="{StaticResource Readout}"
                              Visibility="{Binding HasReport, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <c:SeFrame Style="{StaticResource Frame}" Margin="0,10,0,0" Padding="18,10" Visibility="{Binding IsFull, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{Binding Secondary}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeaderFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource HeaderFont}" FontSize="19" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </c:SeFrame>

                <c:SeFrame Style="{StaticResource Frame}" Margin="0,10,0,0" Visibility="{Binding Checks.Count, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="LIMIT CHECK" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#14303C" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Stat}" Foreground="{StaticResource TextDim}" />
                                            <TextBlock Grid.Column="1" Typography.NumeralAlignment="Tabular">
                                                <Run Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource HeaderFont}" FontWeight="SemiBold" />
                                                <Run Text=" / " Foreground="{StaticResource TextFaint}" />
                                                <Run Text="{Binding Limit, Mode=OneWay}" Foreground="{StaticResource TextDim}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding Brush}" HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:SeFrame>

                <c:SeFrame Style="{StaticResource Frame}" Margin="0,10,0,0" Stroke="{StaticResource Orange}" Brackets="{StaticResource Orange}"
                           Visibility="{Binding HasUnknown, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="UNKNOWN BLOCKS — NOT COUNTED" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Orange}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Unknown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,1" TextTrimming="CharacterEllipsis"><Run Text="{Binding Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Orange}" /><Run Text=" × " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding Id, Mode=OneWay}" /></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Copy IDs" Padding="10,2" Click="OnCopyMods" />
                                <TextBlock Text="MODS NOT ON THIS PC" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Orange}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding MissingMods}" />
                            <TextBlock Text="Subscribe in Steam, then rescan." Style="{StaticResource Dim}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </c:SeFrame>

                <StackPanel Visibility="{Binding IsFull, Converter={StaticResource Visible}}">
                    <DockPanel Margin="0,18,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ASSEMBLER" FontFamily="{StaticResource HeaderFont}" FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox SelectedIndex="{Binding AssemblerIndex}" MinWidth="110">
                                <ComboBoxItem Content="Realistic" />
                                <ComboBoxItem Content="x3" />
                                <ComboBoxItem Content="x10" />
                            </ComboBox>
                            <TextBlock Text="YIELD MODULES" FontFamily="{StaticResource HeaderFont}" FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <ComboBox SelectedIndex="{Binding YieldModules}" MinWidth="64">
                                <ComboBoxItem Content="0" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                            </ComboBox>
                            <Button Margin="14,0,0,0" Click="OnCopy" ToolTip="Copy all three lists (paste into a spreadsheet)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Click="OnExport" Style="{StaticResource AccentButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="White" Margin="0,0,8,0" />
                                    <TextBlock Text="CSV" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="BUILD COST" FontFamily="{StaticResource HeaderFont}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:SeFrame Style="{StaticResource Frame}" Margin="0,0,5,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="COMPONENTS" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource CostRow}" />
                            </StackPanel>
                        </c:SeFrame>
                        <c:SeFrame Grid.Column="1" Style="{StaticResource Frame}" Margin="5,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="INGOTS" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Ingots}" ItemTemplate="{StaticResource CostRow}" />
                            </StackPanel>
                        </c:SeFrame>
                        <c:SeFrame Grid.Column="2" Style="{StaticResource Frame}" Margin="5,0,0,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="ORE" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Ore}" ItemTemplate="{StaticResource CostRow}" />
                            </StackPanel>
                        </c:SeFrame>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
