@inject WebState State
@using SEBlueprint.Core.Imaging

<div class="ic" title="@Row.Name">
    @if (src != null)
    {
        <img src="@src" alt="" />
    }
    else
    {
        <ItemIcon Id="@Row.Id" />
        @if (Bundled != null)
        {
            <img class="over" src="@Bundled" alt="" loading="lazy" onerror="this.remove()" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public CostRow Row { get; set; } = default!;
    [Parameter] public int IconVersion { get; set; }
    string? src;

    string? Bundled => Row.ModId == null && !string.IsNullOrWhiteSpace(Row.Icon) ? "icons/" + IconFiles.FileName(Row.Icon) : null;

    protected override async Task OnParametersSetAsync()
    {
        src = await State.Icons.GetAsync(Row.Icon, Row.ModId);
    }
}
